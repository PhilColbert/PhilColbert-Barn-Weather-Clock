<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_frame"
    android:padding="1dp">

    <LinearLayout
        android:id="@+id/widget_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FF202A36"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.18"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="2dp">
            <TextClock
                android:id="@+id/time_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="#FFFFFFFF"
                android:textSize="28sp"
                android:fontFamily="sans"
                android:includeFontPadding="false"
                android:maxLines="1" />
            <TextClock
                android:id="@+id/clock_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEE d MMM"
                android:format24Hour="EEE d MMM"
                android:textColor="#FFE0E7F2"
                android:textSize="12sp"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="#665C6875" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.05"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="7dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/current_icon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.95"
                    android:text="🌤"
                    android:textSize="38sp"
                    android:gravity="center"
                    android:includeFontPadding="false" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.45"
                    android:orientation="vertical"
                    android:gravity="center_vertical">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/current_now"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Now"
                            android:textColor="#FFFFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="3dp" />
                        <TextView
                            android:id="@+id/current_temp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--°"
                            android:textColor="#FFFFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/current_daynight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Day --°&#10;Night --°"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.08"
                        android:maxLines="2" />
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:id="@+id/current_wind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8 mph SW"
                android:textColor="#FFE0E7F2"
                android:textSize="11sp"
                android:maxLines="1" />
            <TextView
                android:id="@+id/current_weather_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="19 Nov"
                android:textColor="#FFE0E7F2"
                android:textSize="11sp"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="#665C6875" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.05"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/forecast_icon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.95"
                    android:text="☁"
                    android:textSize="38sp"
                    android:gravity="center"
                    android:includeFontPadding="false" />
                <TextView
                    android:id="@+id/forecast_temp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.45"
                    android:text="Day --°&#10;Night --°"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:lineSpacingMultiplier="1.08"
                    android:maxLines="2" />
            </LinearLayout>
            <TextView
                android:id="@+id/forecast_wind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6 mph W"
                android:textColor="#FFE0E7F2"
                android:textSize="11sp"
                android:maxLines="1" />
            <TextView
                android:id="@+id/forecast_weather_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20 Nov"
                android:textColor="#FFE0E7F2"
                android:textSize="11sp"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
